#!/bin/sh
# 公开状态页接口：GET 返回状态，POST ?action=login|switch 执行操作

STATE="/var/run/campus_auth.state"
ACCT_STATE="/etc/campus_auth.acct"
SWITCH_STAMP="/var/run/campus_auth.public_switch"
SWITCH_COOLDOWN=60

state_value() {
    sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n 1
}

# 学号只显示前后四位
mask() {
    printf '%s' "$1" | sed 's/^\(....\).*\(....\)$/\1****\2/'
}

reply() {
    printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n%s\n' "$1"
}

status_json() {
    local current accounts month sec user flow fee
    current="$(state_value account_user)"
    month="$(date +%Y-%m)"
    accounts=""
    for sec in $(uci -q show campus_auth | sed -n 's/^campus_auth\.\([^.=]*\)=account$/\1/p'); do
        [ "$(uci -q get "campus_auth.$sec.enabled")" = "1" ] || continue
        user="$(uci -q get "campus_auth.$sec.username")"
        flow="$(awk -v u="$user" -v m="$month" '$1 == u && $4 == m { print $2 }' "$ACCT_STATE" 2>/dev/null)"
        fee="$(awk -v u="$user" -v m="$month" '$1 == u && $4 == m { print $3 }' "$ACCT_STATE" 2>/dev/null)"
        accounts="$accounts${accounts:+,}{\"user\":\"$(mask "$user")\",\"flow\":\"$flow\",\"fee\":\"$fee\",\"current\":$([ "$user" = "$current" ] && echo true || echo false)}"
    done
    printf '{"state":"%s","message":"%s","updated":"%s","account":"%s","flow":"%s","fee":"%s","time":"%s","accounts":[%s]}' \
        "$(state_value state)" "$(state_value message)" "$(state_value updated)" "$(mask "$current")" \
        "$(state_value flow)" "$(state_value fee)" "$(state_value time)" "$accounts"
}

if [ "$REQUEST_METHOD" = "POST" ]; then
    case "$QUERY_STRING" in
        action=login)
            /usr/bin/campus-auth auto >/dev/null 2>&1
            ;;
        action=switch)
            now="$(date +%s)"
            last="$(cat "$SWITCH_STAMP" 2>/dev/null || echo 0)"
            # 切换会让所有人断网几秒，限制频率防止连点
            if [ $((now - last)) -lt "$SWITCH_COOLDOWN" ]; then
                reply "{\"ok\":false,\"error\":\"刚切换过，请 $((SWITCH_COOLDOWN - now + last)) 秒后再试\"}"
                exit 0
            fi
            printf '%s' "$now" > "$SWITCH_STAMP"
            if ! /usr/bin/campus-auth switch >/dev/null 2>&1; then
                rm -f "$SWITCH_STAMP"
                reply "{\"ok\":false,\"error\":\"没有其他可用账号\"}"
                exit 0
            fi
            ;;
        *)
            reply '{"ok":false,"error":"未知操作"}'
            exit 0
            ;;
    esac
    reply "{\"ok\":$([ "$(state_value state)" = "online" ] && echo true || echo false),\"status\":$(status_json)}"
    exit 0
fi

/usr/bin/campus-auth status >/dev/null 2>&1
reply "$(status_json)"
