#!/bin/sh

STATE="/var/run/campus_auth.state"
ACCT_STATE="/etc/campus_auth.acct"
REPORT_STAMP="/etc/campus_auth.report"
OUTAGE="/var/run/campus_auth.outage"
NO_SPARE="/var/run/campus_auth.nospare"
REJECTED="/var/run/campus_auth.rejected"
LOCK="/var/lock/campus_auth.lock"
LOG="/var/log/campus_auth.log"
DEFAULT_TEMPLATE='{"msgtype":"text","text":{"content":"{text}"}}'

cfg() {
    uci -q get "campus_auth.main.$1" 2>/dev/null || true
}

write_state() {
    umask 077
    {
        printf 'state=%s\n' "$1"
        printf 'message=%s\n' "$2"
        printf 'updated=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        shift 2
        for item in "$@"; do
            printf '%s\n' "$item"
        done
    } > "$STATE"
}

state_value() {
    sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n 1
}

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}

save_account_status() {
    local user="$1" flow="$2" fee="$3" tmp
    [ -n "$user" ] || return
    tmp="$(mktemp -t campus-auth-acct.XXXXXX)"
    if [ -f "$ACCT_STATE" ]; then
        grep -v "^$user " "$ACCT_STATE" >> "$tmp" 2>/dev/null
    fi
    printf '%s %s %s %s\n' "$user" "${flow:--}" "${fee:--}" "$(date +%Y-%m)" >> "$tmp"
    mv "$tmp" "$ACCT_STATE"
}

value_from_html() {
    sed -n "s/.*$1='\([^']*\)'.*/\1/p" "$2" | head -n 1 | sed 's/[[:space:]]*$//'
}

account_sections() {
    uci -q show campus_auth 2>/dev/null | sed -n 's/^campus_auth\.\([^.=]*\)=account$/\1/p'
}

ensure_legacy_account() {
    local sec
    [ -n "$(account_sections)" ] && return
    legacy_configured || return
    sec="$(uci add campus_auth account)"
    uci set "campus_auth.$sec.enabled=1"
    uci set "campus_auth.$sec.priority=10"
    uci set "campus_auth.$sec.username=$(cfg username)"
    uci set "campus_auth.$sec.password=$(cfg password)"
    uci commit campus_auth
}

sorted_accounts() {
    local sec enabled priority
    for sec in $(account_sections); do
        enabled="$(uci -q get "campus_auth.$sec.enabled" 2>/dev/null || echo 0)"
        [ "$enabled" = "1" ] || continue
        priority="$(uci -q get "campus_auth.$sec.priority" 2>/dev/null || echo 100)"
        printf '%s|%s\n' "${priority:-100}" "$sec"
    done | sort -n -t '|' -k 1,1 -k 2,2
}

legacy_configured() {
    [ -n "$(cfg username)" ] && [ -n "$(cfg password)" ]
}

first_account() {
    local line
    line="$(sorted_accounts | head -n 1)"
    [ -n "$line" ] && printf '%s\n' "${line#*|}"
}

active_account() {
    local active
    active="$(cfg active_account)"
    if [ -n "$active" ] && { [ "$active" = "main" ] || account_sections | grep -qx "$active"; }; then
        printf '%s\n' "$active"
        return
    fi
    active="$(first_account)"
    [ -n "$active" ] && printf '%s\n' "$active" && return
    legacy_configured && printf '%s\n' main
}

account_value() {
    local sec="$1" option="$2"
    if [ "$sec" = "main" ]; then
        cfg "$option"
    else
        uci -q get "campus_auth.$sec.$option" 2>/dev/null || true
    fi
}

login_account() {
    local sec="$1" username password portal pid calg hash upass response msg
    username="$(account_value "$sec" username)"
    password="$(account_value "$sec" password)"
    portal="$(cfg portal_url)"
    portal="${portal:-http://172.18.3.3/0.htm}"
    pid="$(cfg pid)"
    calg="$(cfg calg)"
    pid="${pid:-2}"
    calg="${calg:-12345678}"

    if [ -z "$username" ] || [ -z "$password" ] || [ -z "$portal" ]; then
        write_state "not_configured" "登录地址、账号和密码不能为空" "account=$sec" "account_user=$username"
        return 2
    fi

    hash="$(printf '%s' "${pid}${password}${calg}" | md5sum | cut -c1-32)"
    upass="${hash}${calg}${pid}"
    response="$(mktemp -t campus-auth.XXXXXX)"

    if ! curl -k -sS -L --connect-timeout 5 --max-time 15 \
        -H 'Content-Type: application/x-www-form-urlencoded' \
        -H "Origin: ${portal%/*}" \
        -H "Referer: $portal" \
        --data-urlencode "DDDDD=$username" \
        --data-urlencode "upass=$upass" \
        --data-urlencode 'R1=0' \
        --data-urlencode 'R2=1' \
        --data-urlencode 'para=00' \
        --data-urlencode '0MKKey=123456' \
        --data-urlencode 'v6ip=' \
        -o "$response" "$portal"; then
        write_state "error" "登录请求失败" "account=$sec" "account_user=$username"
        log "login request failed for $sec"
        rm -f "$response"
        return 1
    fi

    if grep -q 'Dr.COMWebLoginID_3.htm\|您已经成功登录' "$response"; then
        uci set campus_auth.main.active_account="$sec"
        uci commit campus_auth
        write_state "online" "登录成功" "account=$sec" "account_user=$username"
        log "login successful for $sec"
        rm -f "$response"
        sed -i "/^$sec /d" "$REJECTED" 2>/dev/null
        status
        return 0
    fi

    # 门户错误码，如 Msg=04
    msg="$(grep -o 'Msg=[0-9]*' "$response" | head -n 1 | cut -d = -f 2)"
    write_state "failed" "登录被拒绝（Msg=${msg:-?}）" "account=$sec" "account_user=$username"
    log "login rejected for $sec (Msg=${msg:-?})"
    sed -i "/^$sec /d" "$REJECTED" 2>/dev/null
    printf '%s %s %s\n' "$sec" "$(date +%Y-%m-%d)" "${msg:-?}" >> "$REJECTED"
    rm -f "$response"
    return 1
}

login() {
    local sec current
    sec="$(active_account)"
    if [ -z "$sec" ]; then
        write_state "not_configured" "请先添加至少一个账号"
        return 2
    fi
    current="$(state_value account)"
    if [ -n "$current" ] && [ "$current" != "$sec" ]; then
        logout >/dev/null 2>&1 || true
    fi
    login_account "$sec"
}

# 本月缓存中某用户的已用流量（MB），没有记录按 0 计
cached_flow() {
    cat "$ACCT_STATE" 2>/dev/null | awk -v u="$1" -v m="$(date +%Y-%m)" \
        '$1 == u && $4 == m && $2 != "-" { f = $2 } END { print f + 0 }'
}

# 按本月已用流量从少到多列出可用账号，同流量按优先级；跳过已达余额或流量阈值、以及今天被门户拒绝过的账号
accounts_by_usage() {
    local sec n=0 today
    today="$(date +%Y-%m-%d)"
    {
        cat "$ACCT_STATE" 2>/dev/null
        echo '#'
        sorted_accounts | while IFS='|' read -r _ sec; do
            n=$((n + 1))
            grep -q "^$sec $today " "$REJECTED" 2>/dev/null && continue
            printf '%s %s %s\n' "$n" "$sec" "$(account_value "$sec" username)"
        done
    } | awk -v m="$(date +%Y-%m)" -v t="$(cfg switch_balance)" -v l="$(cfg switch_flow)" '
        $1 == "#" { part = 1; next }
        !part { if ($4 == m) { flow[$1] = $2; fee[$1] = $3 } next }
        {
            f = ($3 in flow && flow[$3] != "-") ? flow[$3] + 0 : 0
            if (t + 0 > 0 && ($3 in fee) && fee[$3] != "-" && fee[$3] + 0 <= t + 0) next
            if (l + 0 > 0 && f >= l + 0) next
            printf "%015.3f %05d %s\n", f, $1, $2
        }' | sort | cut -d ' ' -f 3
}

# 按用量从少到多依次尝试，直到登录成功；都达到阈值时仍按优先级兜底尝试，保证能上网
auto_login() {
    local sec
    for sec in $({ accounts_by_usage; sorted_accounts | cut -d '|' -f 2; } | awk '!seen[$0]++'); do
        login_account "$sec" && return 0
    done
    return 1
}

status() {
    local status_url response time flow fee uid v4ip account account_user
    status_url="$(cfg status_url)"
    status_url="${status_url:-http://172.18.3.3/}"
    response="$(mktemp -t campus-auth-status.XXXXXX)"
    account="$(state_value account)"
    [ -n "$account" ] || account="$(active_account)"
    account_user="$(account_value "$account" username)"

    if ! curl -k -sS -L --connect-timeout 5 --max-time 10 -o "$response" "$status_url"; then
        write_state "unknown" "状态页请求失败" "account=$account"
        rm -f "$response"
        return 1
    fi

    # 未登录页的跳转脚本里也含 Dr.COMWebLoginID_3.htm，只有在线页才是 _1.htm
    if grep -q 'Dr.COMWebLoginID_1.htm' "$response"; then
        time="$(value_from_html time "$response")"
        flow="$(value_from_html flow "$response")"
        fee="$(value_from_html fee "$response")"
        uid="$(value_from_html uid "$response")"
        v4ip="$(value_from_html v4ip "$response")"
        # 门户上实际在线的账号可能不是插件上次登录的账号（如在网页上手动登录过），以 uid 为准
        if [ -n "$uid" ] && [ "$uid" != "$account_user" ]; then
            local sec
            for sec in $(account_sections); do
                if [ "$(account_value "$sec" username)" = "$uid" ]; then
                    account="$sec"
                    account_user="$uid"
                    break
                fi
            done
        fi
        local flow_int flow_frac flow_display fee_int fee_frac fee_display
        flow_int=0
        flow_frac=0
        if [ -n "$flow" ] 2>/dev/null; then
            flow_frac=$((flow % 1024))
            flow_int=$((flow - flow_frac))
            flow_frac=$((flow_frac * 1000))
            flow_frac=$((flow_frac - flow_frac % 1024))
            flow_int=$((flow_int / 1024))
            flow_frac=$((flow_frac / 1024))
        fi
        if [ "$flow_frac" -lt 10 ]; then
            flow_display="${flow_int}.00${flow_frac}"
        elif [ "$flow_frac" -lt 100 ]; then
            flow_display="${flow_int}.0${flow_frac}"
        else
            flow_display="${flow_int}.${flow_frac}"
        fi

        fee_int=0
        fee_frac=0
        if [ -n "$fee" ] 2>/dev/null; then
            fee_int=$((fee - fee % 100))
            fee_frac=$(((fee_int % 10000) / 100))
            fee_int=$((fee_int / 10000))
        fi
        if [ "$fee_frac" -lt 10 ]; then
            fee_display="${fee_int}.0${fee_frac}"
        else
            fee_display="${fee_int}.${fee_frac}"
        fi

        write_state "online" "状态页可用" \
            "account=$account" "account_user=$account_user" "time=$time" "flow=$flow_display" "fee=$fee_display" "uid=$uid" "v4ip=$v4ip"
        save_account_status "$account_user" "$flow_display" "$fee_display"
    else
        write_state "offline" "状态页显示未认证" "account=$account" "account_user=$account_user"
    fi
    rm -f "$response"
}

logout() {
    local logout_url
    logout_url="$(cfg logout_url)"
    logout_url="${logout_url:-http://172.18.3.3/F.htm}"
    if curl -k -sS -L --connect-timeout 5 --max-time 10 -o /dev/null "$logout_url"; then
        write_state "offline" "已注销"
        log "logout requested"
        return 0
    fi
    write_state "error" "注销请求失败"
    return 1
}

# 切到用量最少的其他可用账号；新账号登录失败时交给 auto_login 继续尝试
switch_account() {
    local current next
    current="$(state_value account)"
    next="$(accounts_by_usage | grep -vx "$current" | head -n 1)"
    [ -n "$next" ] || return 1

    logout >/dev/null 2>&1 || true
    login_account "$next" || auto_login
}

notify() {
    local url tpl text body
    url="$(cfg webhook_url)"
    [ -n "$url" ] || return 0
    tpl="$(cfg webhook_template)"
    [ -n "$tpl" ] || tpl="$DEFAULT_TEMPLATE"
    # 转义成 JSON 字符串内容后替换模板里的 {text}
    text="$(printf '%s' "$1" | awk 'BEGIN { ORS = "" } {
        gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, " ")
        if (NR > 1) print "\\n"
        print
    }')"
    body="$(printf '%s' "$tpl" | T="$text" awk '{
        out = ""; s = $0
        while ((i = index(s, "{text}")) > 0) { out = out substr(s, 1, i - 1) ENVIRON["T"]; s = substr(s, i + 6) }
        print out s
    }')"
    if curl -sS --connect-timeout 5 --max-time 15 -H 'Content-Type: application/json' \
        -d "$body" -o /dev/null "$url"; then
        return 0
    fi
    log "webhook notify failed"
    return 1
}

report_text() {
    local current
    current="$(state_value account_user)"
    printf '校园网用量日报 %s\n' "$(date '+%Y-%m-%d %H:%M')"
    printf '状态：%s，当前账号：%s\n' "$(state_value state)" "${current:-无}"
    {
        cat "$ACCT_STATE" 2>/dev/null
        echo '#'
        sorted_accounts | while IFS='|' read -r _ sec; do
            account_value "$sec" username
        done
    } | awk -v m="$(date +%Y-%m)" '
        $1 == "#" { part = 1; next }
        !part { if ($4 == m) { flow[$1] = $2; fee[$1] = $3 } next }
        {
            if ($1 in flow) {
                printf "%s：已用 %s MB，余额 %s 元\n", $1, flow[$1], fee[$1]
                if (flow[$1] != "-") total += flow[$1]
            } else {
                printf "%s：本月暂无数据\n", $1
            }
        }
        END { printf "本月合计：%.2f GB", total / 1024 }'
    while read -r sec day msg; do
        [ "$day" = "$(date +%Y-%m-%d)" ] && printf '\n%s：今天登录被门户拒绝（Msg=%s）' "$(account_value "$sec" username)" "$msg"
    done 2>/dev/null < "$REJECTED"
}

report() {
    [ -n "$(cfg webhook_url)" ] || return 1
    status >/dev/null 2>&1
    notify "$(report_text)"
}

# 每天到 report_hour 点后发一次日报
daily_report() {
    local hour today
    hour="$(cfg report_hour)"
    [ -n "$hour" ] || return 0
    today="$(date +%Y-%m-%d)"
    [ "$(cat "$REPORT_STAMP" 2>/dev/null)" = "$today" ] && return 0
    [ "$(date +%H | sed 's/^0//')" -ge "$hour" ] 2>/dev/null || return 0
    printf '%s\n' "$today" > "$REPORT_STAMP"
    notify "$(report_text)"
}

# 检查一次状态：掉线则登录，在线则按阈值和均衡切换、发日报
check() {
    local threshold flow_limit gap state fee flow should_switch user best
    threshold="$(cfg switch_balance)"
    threshold="${threshold:-0}"
    flow_limit="$(cfg switch_flow)"
    flow_limit="${flow_limit:-0}"
    gap="$(cfg balance_gap)"
    gap="${gap:-0}"
    status >/dev/null 2>&1
    state="$(state_value state)"
    if [ "$state" = "offline" ]; then
        if auto_login >/dev/null 2>&1; then
            if [ -f "$OUTAGE" ]; then
                notify "校园网自动登录曾全部失败（自 $(cat "$OUTAGE") 起），现已恢复，当前账号：$(state_value account_user)"
                rm -f "$OUTAGE"
            fi
        else
            # 离线时发不出通知，记下开始时间，恢复后补报
            [ -f "$OUTAGE" ] || date '+%Y-%m-%d %H:%M:%S' > "$OUTAGE"
            log "auto login failed for all accounts"
        fi
    elif [ "$state" = "online" ]; then
        fee="$(state_value fee)"
        flow="$(state_value flow)"
        should_switch=0
        if [ -n "$fee" ] && awk -v fee="$fee" -v threshold="$threshold" 'BEGIN { exit !(threshold > 0 && fee <= threshold) }'; then
            should_switch=1
        fi
        if [ "$should_switch" -eq 0 ] && [ -n "$flow" ] && awk -v flow="$flow" -v limit="$flow_limit" 'BEGIN { exit !(limit > 0 && flow >= limit) }'; then
            should_switch=1
        fi
        user="$(state_value account_user)"
        if [ "$should_switch" -eq 1 ]; then
            if switch_account >/dev/null 2>&1; then
                notify "账号 $user 已达到切换阈值（已用 $flow MB，余额 $fee 元），已切换到 $(state_value account_user)"
            elif [ "$(cat "$NO_SPARE" 2>/dev/null)" != "$user" ]; then
                # 无账号可切时每个账号只提醒一次，避免每个检测周期重复推送
                printf '%s' "$user" > "$NO_SPARE"
                notify "账号 $user 已达到切换阈值（已用 $flow MB，余额 $fee 元），但没有其他可用账号"
            fi
        elif [ "$gap" -gt 0 ] 2>/dev/null; then
            # 当前账号比用量最少的账号多用 gap MB 以上时切过去
            best="$(accounts_by_usage | head -n 1)"
            if [ -n "$best" ] && [ "$best" != "$(state_value account)" ] && \
                awk -v a="$flow" -v b="$(cached_flow "$(account_value "$best" username)")" -v g="$gap" 'BEGIN { exit !(a - b >= g) }'; then
                log "balance: switching from $user to $best"
                switch_account >/dev/null 2>&1
            fi
        fi
        daily_report
    fi
}

# 立即登录：仅在离线时按用量选账号登录，供公开状态页使用
auto() {
    status >/dev/null 2>&1
    [ "$(state_value state)" = "online" ] && return 0
    auto_login
}

# 登录、切换等操作可能同时来自后台监控、LuCI 和公开状态页，串行执行
with_lock() {
    flock 9 && "$@"
} 9>"$LOCK"

monitor() {
    local interval
    interval="$(cfg interval)"
    interval="${interval:-300}"
    while :; do
        with_lock check
        # 开机时网络可能还没就绪，状态页不可达时短间隔重试
        if [ "$(state_value state)" = "unknown" ]; then
            sleep 15
        else
            sleep "$interval"
        fi
    done
}

case "$1" in
    monitor) ensure_legacy_account; monitor ;;
    login|status|logout|report|auto) ensure_legacy_account; with_lock "$1" ;;
    switch) ensure_legacy_account; with_lock switch_account ;;
    *) echo "Usage: $0 {login|status|logout|switch|monitor|report|auto}" >&2; exit 2 ;;
esac
